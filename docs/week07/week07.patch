diff --git a/frontend/src/lib/graduationMemory.js b/frontend/src/lib/graduationMemory.js
new file mode 100644
index 0000000..f2c03d5
--- /dev/null
+++ b/frontend/src/lib/graduationMemory.js
@@ -0,0 +1,131 @@
+// C route: derived explanations live only in this mounted page; never localStorage.
+export const VALIDITY_MESSAGES = {
+  EXPIRED: "說明已到期，請重新產生。",
+  SOURCE_CHANGED: "修課資料或規則已更新，舊說明停止使用；請重新整理進度。",
+  SESSION_CHANGED: "工作階段已變更，舊說明已清除。",
+  UNAVAILABLE: "目前無法確認資料有效性，舊說明已停止使用。",
+};
+
+export function validityReason(validity, current) {
+  if (!validity || !current) return "UNAVAILABLE";
+  if (validity.scope_id !== current.scope_id) return "SESSION_CHANGED";
+  if (validity.source_sha256 !== current.source_sha256) return "SOURCE_CHANGED";
+  if (current.server_now_ms >= validity.expires_at_ms) return "EXPIRED";
+  return "";
+}
+
+export class GraduationMemory {
+  constructor({ request, update, now = () => performance.now() }) {
+    this.request = request;
+    this.update = update;
+    this.now = now;
+    this.sequence = 0;
+    this.checkSequence = 0;
+    this.workflow = null;
+    this.deadline = 0;
+    this.active = true;
+  }
+  clear(reason = "") {
+    this.sequence += 1;
+    this.checkSequence += 1;
+    this.workflow = null;
+    this.deadline = 0;
+    if (this.active) this.update({ workflow: null, reason, busy: false });
+  }
+  dispose() {
+    this.active = false;
+    this.clear();
+  }
+  async generate() {
+    this.clear();
+    const sequence = this.sequence;
+    this.update({ workflow: null, reason: "", busy: true });
+    try {
+      // Establish a server-issued browser scope before any model request.
+      await this.request("graduation-context");
+      if (!this.active || sequence !== this.sequence) return;
+      const data = await this.request("graduation-explanation", {
+        method: "POST",
+      });
+      if (!this.active || sequence !== this.sequence) return;
+      const started = this.now();
+      const current = await this.request("graduation-context");
+      if (!this.active || sequence !== this.sequence) return;
+      const reason =
+        data.workflow.status === "stale"
+          ? data.workflow.stop_reason === "EXPIRED"
+            ? "EXPIRED"
+            : "SOURCE_CHANGED"
+          : validityReason(data.workflow.validity, current);
+      if (reason) {
+        this.clear(reason);
+        return;
+      }
+      this.workflow = data.workflow;
+      // Server time defines remaining life; round-trip delay only shortens it.
+      this.deadline =
+        started + data.workflow.validity.expires_at_ms - current.server_now_ms;
+      if (this.now() >= this.deadline) {
+        this.clear("EXPIRED");
+        return;
+      }
+      this.update({
+        workflow: this.workflow,
+        progress: data.progress,
+        reason: "",
+        busy: false,
+      });
+    } catch (error) {
+      if (this.active && sequence === this.sequence) this.clear("UNAVAILABLE");
+    }
+  }
+  tick() {
+    if (this.workflow && this.now() >= this.deadline) this.clear("EXPIRED");
+  }
+  async verify() {
+    this.tick();
+    if (!this.workflow) return;
+    const sequence = this.sequence;
+    const check = ++this.checkSequence;
+    // Hide clauses while revalidating on timer/focus. A failed request cannot reuse them.
+    this.update({ workflow: null, reason: "", busy: false });
+    const started = this.now();
+    try {
+      const current = await this.request("graduation-context");
+      if (
+        !this.active ||
+        sequence !== this.sequence ||
+        check !== this.checkSequence
+      )
+        return;
+      const reason = validityReason(this.workflow.validity, current);
+      if (reason) {
+        this.clear(reason);
+        return;
+      }
+      this.deadline = Math.min(
+        this.deadline,
+        started + this.workflow.validity.expires_at_ms - current.server_now_ms,
+      );
+      this.tick();
+      if (this.workflow)
+        this.update({ workflow: this.workflow, reason: "", busy: false });
+    } catch (error) {
+      if (
+        this.active &&
+        sequence === this.sequence &&
+        check === this.checkSequence
+      )
+        this.clear("UNAVAILABLE");
+    }
+  }
+  async reset() {
+    this.clear("SESSION_CHANGED");
+    const sequence = this.sequence;
+    try {
+      await this.request("graduation-session/reset", { method: "POST" });
+    } catch (error) {
+      if (sequence === this.sequence) this.clear("UNAVAILABLE");
+    }
+  }
+}
diff --git a/frontend/tests/graduationMemory.test.js b/frontend/tests/graduationMemory.test.js
new file mode 100644
index 0000000..c852367
--- /dev/null
+++ b/frontend/tests/graduationMemory.test.js
@@ -0,0 +1,188 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  GraduationMemory,
+  validityReason,
+} from "../src/lib/graduationMemory.js";
+
+const context = (time = 1000, source = "v1", scope = "s1") => ({
+  scope_id: scope,
+  source_sha256: source,
+  server_now_ms: time,
+});
+const data = () => ({
+  progress: { earned_credits: 3 },
+  workflow: {
+    status: "verified",
+    run_id: "synthetic-run",
+    explanation: [{ text: "3 credits" }],
+    validity: { ...context(), issued_at_ms: 1000, expires_at_ms: 301000 },
+  },
+});
+function setup(request) {
+  let now = 1000;
+  const updates = [];
+  const store = new GraduationMemory({
+    request,
+    update: (s) => updates.push(s),
+    now: () => now,
+  });
+  return {
+    store,
+    updates,
+    advance: (value) => {
+      now = value;
+    },
+  };
+}
+
+test("normal first read, TTL boundary removes clauses, later reads do not extend TTL", async () => {
+  const { store, updates, advance } = setup(async (path) =>
+    path === "graduation-explanation" ? data() : context(),
+  );
+  await store.generate();
+  assert.equal(updates.at(-1).workflow.run_id, "synthetic-run");
+  advance(2000);
+  await store.verify();
+  advance(301000);
+  store.tick();
+  assert.equal(updates.at(-1).workflow, null);
+  assert.equal(updates.at(-1).reason, "EXPIRED");
+});
+
+test("source update on recheck removes explanation", async () => {
+  let source = "v1";
+  const { store, updates } = setup(async (path) =>
+    path === "graduation-explanation" ? data() : context(1000, source),
+  );
+  await store.generate();
+  source = "v2";
+  await store.verify();
+  assert.equal(updates.at(-1).reason, "SOURCE_CHANGED");
+  assert.equal(store.workflow, null);
+});
+
+test("session change removes explanation; no model call on verify", async () => {
+  let scope = "s1",
+    calls = 0;
+  const { store, updates } = setup(async (path) => {
+    if (path === "graduation-explanation") {
+      calls++;
+      return data();
+    }
+    return context(1000, "v1", scope);
+  });
+  await store.generate();
+  scope = "s2";
+  await store.verify();
+  assert.equal(updates.at(-1).reason, "SESSION_CHANGED");
+  assert.equal(calls, 1);
+});
+
+test("failed source check fails closed with no stale clauses", async () => {
+  let failed = false;
+  const { store, updates } = setup(async (path) => {
+    if (failed) throw Error("injected timeout");
+    return path === "graduation-explanation" ? data() : context();
+  });
+  await store.generate();
+  failed = true;
+  await store.verify();
+  assert.equal(updates.at(-1).reason, "UNAVAILABLE");
+  assert.equal(store.workflow, null);
+});
+
+test("old model response after clear cannot overwrite a new session", async () => {
+  let resolve;
+  const held = new Promise((r) => {
+    resolve = r;
+  });
+  const { store, updates } = setup(async (path) =>
+    path === "graduation-explanation" ? held : context(),
+  );
+  const pending = store.generate();
+  await Promise.resolve();
+  await Promise.resolve();
+  store.clear("SESSION_CHANGED");
+  resolve(data());
+  await pending;
+  assert.equal(updates.at(-1).workflow, null);
+  assert.equal(updates.at(-1).reason, "SESSION_CHANGED");
+});
+
+test("old revalidation cannot restore cleared state", async () => {
+  let hold = false,
+    resolve;
+  const held = new Promise((r) => {
+    resolve = r;
+  });
+  const { store, updates } = setup(async (path) =>
+    path === "graduation-explanation" ? data() : hold ? held : context(),
+  );
+  await store.generate();
+  hold = true;
+  const pending = store.verify();
+  store.clear("SESSION_CHANGED");
+  resolve(context());
+  await pending;
+  assert.equal(updates.at(-1).reason, "SESSION_CHANGED");
+});
+
+test("source changed during model request is rejected before first display", async () => {
+  const d = data();
+  d.workflow.status = "stale";
+  d.workflow.explanation = [];
+  d.workflow.stop_reason = "SOURCE_CHANGED";
+  const { store, updates } = setup(async (path) =>
+    path === "graduation-explanation" ? d : context(),
+  );
+  await store.generate();
+  assert.equal(updates.at(-1).reason, "SOURCE_CHANGED");
+  assert.ok(updates.every((s) => s.workflow === null));
+});
+
+test("dispose prevents late response after navigation/unmount", async () => {
+  let resolve;
+  const held = new Promise((r) => {
+    resolve = r;
+  });
+  const { store, updates } = setup(async () => held);
+  const pending = store.generate();
+  store.dispose();
+  const count = updates.length;
+  resolve(context());
+  await pending;
+  assert.equal(updates.length, count);
+});
+
+test("explicit new session calls reset API and removes all clauses", async () => {
+  const routes = [];
+  const { store, updates } = setup(async (path) => {
+    routes.push(path);
+    return path === "graduation-explanation" ? data() : context();
+  });
+  await store.generate();
+  await store.reset();
+  assert.equal(routes.at(-1), "graduation-session/reset");
+  assert.equal(updates.at(-1).workflow, null);
+});
+
+test("expiry checked using server time, never client-provided identity", () => {
+  assert.equal(
+    validityReason(data().workflow.validity, context(301000)),
+    "EXPIRED",
+  );
+  assert.equal(validityReason(null, context()), "UNAVAILABLE");
+});
+
+test("server-expired in-flight result reports expiry instead of source update", async () => {
+  const d = data();
+  d.workflow.status = "stale";
+  d.workflow.stop_reason = "EXPIRED";
+  d.workflow.explanation = [];
+  const { store, updates } = setup(async (path) =>
+    path === "graduation-explanation" ? d : context(),
+  );
+  await store.generate();
+  assert.equal(updates.at(-1).reason, "EXPIRED");
+});
