# 課堂主示範維持 vertex；後續可切換為 openai。
STUDY_AGENT_PROVIDER=vertex

# Vertex 使用 Google Cloud Application Default Credentials，不在 .env 放憑證。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_GEMINI_MODEL=gemini-2.5-flash

# OpenAI 僅供後端讀取。真實金鑰只能放在被 Git 忽略的 .env.local。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 舊 Week 04/06/07 runner 相容設定；主網站不使用 API key。
GEMINI_API_KEY=
GEMINI_MODEL=
