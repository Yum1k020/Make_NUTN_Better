  },
  "dependencies": {
    "@openai/agents": "^0.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.7",
    "vite": "^8.3.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
